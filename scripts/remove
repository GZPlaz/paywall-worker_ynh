#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE THE CLOUDFLARE WORKER
#=================================================

if [ "$(ynh_app_setting_get --key=cf_cleanup_on_remove)" == "1" ] \
    && [ -n "$(ynh_app_setting_get --key=cf_api_token)" ] \
    && [ -x "$install_dir/venv/bin/python" ] && [ -f "$install_dir/config.json" ]; then
    ynh_script_progression "Removing the Cloudflare Worker and its routes..."
    _paywall_cli undeploy-worker \
        || ynh_print_warn "Could not remove the Cloudflare Worker, delete it manually from the Cloudflare dashboard."
fi

#=================================================
# REMOVE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi

ynh_config_remove_systemd

ynh_config_remove_nginx

ynh_config_remove_logrotate

ynh_safe_rm "/var/log/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
